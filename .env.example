# =============================================================
# PsicoRank AI — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores
# =============================================================

# ── Supabase ─────────────────────────────────────────────────
# Crie um projeto em https://supabase.com
# Copie em: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ── Anthropic (Claude) ────────────────────────────────────────
# Gere em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modelo de geração (padrão recomendado: haiku = rápido e barato)
# Opções: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-7
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── URL pública (OBRIGATÓRIO em produção) ────────────────────
# Preencha com a URL exata do seu deploy no Vercel
# Usado em: SEO metadata, sitemap.xml, robots.txt, redirect OAuth GMB
NEXT_PUBLIC_SITE_URL=https://psicorank-ai.vercel.app

# ── Google OAuth — Google Meu Negócio (planos Pro e Clínica) ─
# Crie em: https://console.cloud.google.com → APIs e Serviços → Credenciais
# Escopo necessário: https://www.googleapis.com/auth/business.manage
# URI de redirecionamento autorizado: ${NEXT_PUBLIC_SITE_URL}/api/gmb/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
